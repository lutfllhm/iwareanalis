datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model BarangJasa {
  id                 Int       @id @default(autoincrement())
  kode_barang        String    @unique @db.VarChar(191)
  nama_barang        String    @db.VarChar(255)
  kategori_barang    String    @db.VarChar(100)
  nama_merek_barang  String?   @db.VarChar(100)
  non_aktif          Boolean   @default(false)
  tgl_jam_pembuatan  DateTime
  kts_gdng_pengguna  Decimal   @db.Decimal(18, 4)
  kts_semua_gdng     Decimal   @db.Decimal(18, 4)
  synced_at          DateTime  @default(now())
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  rincian RincianPenjualanBarang[]

  @@map("barang_jasa")
}

model Pelanggan {
  id                              Int       @id @default(autoincrement())
  id_pelanggan                    String    @unique @db.VarChar(191)
  id_karyawan_default_penjual     String?   @db.VarChar(100)
  id_karyawan_tenaga_penjual_kedua String?  @db.VarChar(100)
  nama                            String    @db.VarChar(255)
  kategori_pelanggan              String?   @db.VarChar(100)
  non_aktif                       Boolean   @default(false)
  kota_pengiriman                 String?   @db.VarChar(100)
  provinsi_pengiriman             String?   @db.VarChar(100)
  tgl_jam_pembuatan               DateTime?
  nama_default_penjual            String?   @db.VarChar(255)
  alamat_lengkap_pengiriman       String?   @db.Text
  synced_at                       DateTime  @default(now())
  created_at                      DateTime  @default(now())
  updated_at                      DateTime  @updatedAt

  faktur FakturPenjualan[]
  retur  ReturPenjualan[]

  @@map("pelanggan")
}

model FakturPenjualan {
  id                        Int       @id @default(autoincrement())
  nomor                     String    @unique @db.VarChar(191)
  id_pelanggan              String    @db.VarChar(191)
  id_karyawan_penjual_utama String?   @db.VarChar(100)
  tanggal                   DateTime  @db.Date
  total                     Decimal   @db.Decimal(18, 4)
  pembayaran                Decimal   @db.Decimal(18, 4)
  synced_at                 DateTime  @default(now())
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  pelanggan Pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: Cascade)
  rincian   RincianPenjualanBarang[]

  @@index([id_pelanggan])
  @@map("faktur_penjualan")
}

model RincianPenjualanBarang {
  id                              Int       @id @default(autoincrement())
  nomor                           String    @db.VarChar(191)
  kode                            String    @db.VarChar(191)
  nama_barang                     String    @db.VarChar(255)
  kuantitas                       Decimal   @db.Decimal(18, 4)
  harga                           Decimal   @db.Decimal(18, 4)
  total_harga                     Decimal   @db.Decimal(18, 4)
  penjualan                       Decimal   @db.Decimal(18, 4)
  tanggal                         DateTime  @db.Date
  nama_pelanggan                  String?   @db.VarChar(255)
  nama_tenaga_penjual             String?   @db.VarChar(255)
  id_karyawan_tenaga_penjual      String?   @db.VarChar(100)
  id_karyawan_tenaga_penjual_kedua String?  @db.VarChar(100)
  synced_at                       DateTime  @default(now())
  created_at                      DateTime  @default(now())
  updated_at                      DateTime  @updatedAt

  faktur FakturPenjualan @relation(fields: [nomor], references: [nomor], onDelete: Cascade)
  barang BarangJasa      @relation(fields: [kode], references: [kode_barang], onDelete: Cascade)

  @@index([nomor])
  @@index([kode])
  @@map("rincian_penjualan_barang")
}

model ReturPenjualan {
  id                          Int       @id @default(autoincrement())
  nomor                       String    @unique @db.VarChar(191)
  id_pelanggan                String    @db.VarChar(191)
  id_karyawan_penjual_utama   String?   @db.VarChar(100)
  tanggal                     DateTime  @db.Date
  total                       Decimal   @db.Decimal(18, 4)
  pembayaran_faktur_penjualan Decimal   @db.Decimal(18, 4)
  nilai_retur_faktur          Decimal   @db.Decimal(18, 4)
  synced_at                   DateTime  @default(now())
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  pelanggan Pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: Cascade)

  @@index([id_pelanggan])
  @@map("retur_penjualan")
}

model MutasiSerialNumber {
  id              Int      @id @default(autoincrement())
  kode_barang     String   @db.VarChar(191)
  serial_number   String   @db.VarChar(191)
  tanggal         DateTime @db.Date
  tipe_mutasi     String   @db.VarChar(50)
  jumlah          Decimal  @db.Decimal(18, 4)
  nama_gudang     String?  @db.VarChar(255)
  keterangan      String?  @db.Text
  synced_at       DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([kode_barang])
  @@index([serial_number])
  @@index([tanggal])
  @@map("mutasi_serial_number")
}

model RingkasanMutasiStok {
  id              Int      @id @default(autoincrement())
  kode_barang     String   @db.VarChar(191)
  nama_barang     String   @db.VarChar(255)
  tanggal_mulai   DateTime @db.Date
  tanggal_akhir   DateTime @db.Date
  nama_gudang     String?  @db.VarChar(255)
  stok_awal       Decimal  @db.Decimal(18, 4)
  masuk           Decimal  @db.Decimal(18, 4)
  keluar          Decimal  @db.Decimal(18, 4)
  stok_akhir      Decimal  @db.Decimal(18, 4)
  synced_at       DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([kode_barang])
  @@index([tanggal_mulai, tanggal_akhir])
  @@map("ringkasan_mutasi_stok")
}

model WorkOrder {
  id                Int      @id @default(autoincrement())
  nomor_wo          String   @unique @db.VarChar(191)
  tanggal           DateTime @db.Date
  kode_barang_hasil String?  @db.VarChar(191)
  nama_barang_hasil String?  @db.VarChar(255)
  kuantitas_target  Decimal  @db.Decimal(18, 4)
  kuantitas_realisasi Decimal @db.Decimal(18, 4)
  status            String   @db.VarChar(50)
  keterangan        String?  @db.Text
  synced_at         DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([tanggal])
  @@index([kode_barang_hasil])
  @@map("work_order")
}

enum Role {
  admin
  analyst
  viewer
}

model User {
  id                    Int       @id @default(autoincrement())
  nama                  String    @db.VarChar(100)
  email                 String    @unique @db.VarChar(191)
  password_hash         String    @db.VarChar(255)
  role                  Role      @default(viewer)
  is_active             Boolean   @default(true)
  two_fa_enabled        Boolean   @default(false)
  two_fa_secret         String?   @db.VarChar(255)
  failed_login_attempts Int       @default(0)
  lockout_until         DateTime?
  last_login            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("users")
}

enum SyncStatus {
  SUCCESS
  FAILED
}

model SyncLog {
  id           Int        @id @default(autoincrement())
  modul        String     @db.VarChar(100)
  status       SyncStatus
  jumlah_baris Int        @default(0)
  pesan_error  String?    @db.Text
  durasi_ms    Int
  created_at   DateTime   @default(now())

  @@map("sync_logs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  user_email String?  @db.VarChar(191)
  aksi       String   @db.VarChar(100)
  target     String   @db.VarChar(255)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(255)
  created_at DateTime @default(now())

  @@map("audit_logs")
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(191)
  value      String   @db.LongText
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
}
